# Copy this file to .env and fill in real values for your environment.
# These variables are read by shanmuga_backend/settings.py.

# Set to 'True' to enable Django debug mode (never 'True' in production).
DJANGO_DEBUG=False

# Django secret key. Generate a new, unique value for production deployments.
DJANGO_SECRET_KEY=

# Gmail SMTP app password used for EMAIL_HOST_USER (resultssmrft@gmail.com).
EMAIL_HOST_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Set to 'True' to allow all CORS origins (escape hatch, not recommended in production).
CORS_ALLOW_ALL_ORIGINS=False
